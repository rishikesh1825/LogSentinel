# Rendered by the nginx image at start-up (envsubst replaces ${...} variables).
# HTTP only redirects to HTTPS; TLS uses the self-signed certificate in ./certs.

server {
    listen 80;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;

    root  /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # The browser calls /api/... on this origin; nginx forwards to the backend service.
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        client_max_body_size 6m;
    }

    # Grafana is served under /grafana/ on this HTTPS origin so it can be embedded
    # in the Monitoring tab (an http:// iframe inside an https:// page is blocked).
    location /grafana/ {
        proxy_pass       ${GRAFANA_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
