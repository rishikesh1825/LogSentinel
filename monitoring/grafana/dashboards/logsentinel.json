{
  "uid": "logsentinel",
  "title": "LogSentinel",
  "tags": [
    "logsentinel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Application (backend API)",
      "id": 100,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(logsentinel_http_requests_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 predict latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(logsentinel_request_latency_seconds_bucket{endpoint=~\"/api/v1/predict.*\"}[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Anomaly rate (last request)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "logsentinel_last_anomaly_rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unseen-template rate (5m) - drift",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(logsentinel_unseen_lines_total[5m])) / clamp_min(sum(rate(logsentinel_lines_processed_total[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Model server up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(logsentinel_model_up)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by endpoint and status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, status) (rate(logsentinel_http_requests_total[1m]))",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency (API end-to-end and model server)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "API p50",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(logsentinel_request_latency_seconds_bucket{endpoint=~\"/api/v1/predict.*\"}[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "API p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(logsentinel_request_latency_seconds_bucket{endpoint=~\"/api/v1/predict.*\"}[5m])))"
        },
        {
          "refId": "C",
          "legendFormat": "model p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(logsentinel_model_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Lines, sessions and anomalies per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "lines",
          "expr": "sum(rate(logsentinel_lines_processed_total[1m])) * 60"
        },
        {
          "refId": "B",
          "legendFormat": "sessions",
          "expr": "sum(rate(logsentinel_sessions_scored_total[1m])) * 60"
        },
        {
          "refId": "C",
          "legendFormat": "anomalies",
          "expr": "sum(rate(logsentinel_anomalies_total[1m])) * 60"
        },
        {
          "refId": "D",
          "legendFormat": "unseen lines",
          "expr": "sum(rate(logsentinel_unseen_lines_total[1m])) * 60"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Errors by type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (rate(logsentinel_errors_total[5m])) * 60",
          "legendFormat": "{{error_type}} / min"
        }
      ]
    },
    {
      "type": "row",
      "title": "Data & ML pipeline (Pushgateway)",
      "id": 101,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Stage duration (last run, seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stage) (logsentinel_pipeline_stage_duration_seconds)",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Stage throughput (lines / s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stage) (logsentinel_pipeline_stage_lines_per_second)",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Stage last result",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stage) (logsentinel_pipeline_stage_success)",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Infrastructure (cAdvisor + node-exporter)",
      "id": 102,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Container CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\\\\.scope\"}[1m])), \"container\", \"$1\", \"id\", \"/system.slice/docker-(.{12}).*\")",
          "legendFormat": "{{container}}"
        }
      ],
      "description": "Per container, labelled by short Docker ID - map with `docker ps`."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Container memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (id) (container_memory_usage_bytes{id=~\"/system.slice/docker-.*\\\\.scope\"}), \"container\", \"$1\", \"id\", \"/system.slice/docker-(.{12}).*\")",
          "legendFormat": "{{container}}"
        }
      ],
      "description": "Per container, labelled by short Docker ID - map with `docker ps`."
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Host CPU and memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "CPU",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))"
        },
        {
          "refId": "B",
          "legendFormat": "memory",
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Scrape targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    }
  ]
}
